(ld "portcullis.acl2")
(set-ld-skip-proofsp t state)
(include-book "2_3-validation_instructions" :load-compiled-file nil)
(in-package "W3T")
(defconst *a* '(:_def (:rec ((:sub nil nil (:struct nil)))) 0))
(defconst *b* (list :_def (list :rec (list (list :sub nil (list *a*) '(:struct nil)))) 0))
(defconst *c* (list :%rec (list :types *a* *b*) '(:tags) '(:globals) '(:mems) '(:tables) '(:funcs) '(:datas) '(:elems) '(:locals) '(:labels) '(:return) '(:refs) '(:recs)))
(defmacro kase (name form expect) `(cw "CASE ~s0: expected ~x1, got ~x2~%" ,name ,expect ,form))
(cw "ENC ~x0~%" (list (deftype-p *a*) (deftype-p *b*) (context-p *c*) (heaptype-p '(:_idx 0)) (deftype_ok *c* *a*) (deftype_ok *c* *b*)))
(kase "T1 (type 0) <: struct (typeidx-l)" (heaptype_sub *c* '(:_idx 0) '(:struct)) t)
(kase "T2 deftype A <: struct" (heaptype_sub *c* *a* '(:struct)) t)
(kase "T3 A <: A" (heaptype_sub *c* *a* *a*) t)
(kase "T4 B <: A (declared supertype)" (heaptype_sub *c* *b* *a*) t)
(kase "T5 (type 1) <: (type 0)" (heaptype_sub *c* '(:_idx 1) '(:_idx 0)) t)
(kase "T6 A <: (type 0) (typeidx-r)" (heaptype_sub *c* *a* '(:_idx 0)) t)
(kase "T7 A <: B" (heaptype_sub *c* *a* *b*) nil)
(kase "T8 (ref (type 1)) <: (ref null (type 0))" (reftype_sub *c* '(:ref nil (:_idx 1)) '(:ref ((:null)) (:_idx 0))) t)
(kase "T9 A <: eq (needs trans)" (heaptype_sub *c* *a* '(:eq)) t)
(kase "T10 none <: struct" (heaptype_sub *c* '(:none) '(:struct)) t)
(kase "T11 (type 0) <: (type 0)" (heaptype_sub *c* '(:_idx 0) '(:_idx 0)) t)
(kase "T12 struct <: (type 0)" (heaptype_sub *c* '(:struct) '(:_idx 0)) nil)
(kase "V1 reftype_sub (ref i31) <: (ref null i31)" (reftype_sub *c* '(:ref nil (:i31)) '(:ref ((:null)) (:i31))) t)
(kase "V2 valtype_sub (ref i31) <: (ref null i31) (delegates to Reftype_sub)" (valtype_sub *c* '(:ref nil (:i31)) '(:ref ((:null)) (:i31))) t)
(kase "V3 valtype_sub i32 <: i32" (valtype_sub *c* '(:i32) '(:i32)) t)
(kase "V4 resulttype_sub [(ref i31)] <: [(ref null i31)]" (resulttype_sub *c* '((:ref nil (:i31))) '((:ref ((:null)) (:i31)))) t)
(kase "V5 deftype_sub B <: A" (deftype_sub *c* *b* *a*) t)
(kase "V6 valtype_ok (ref null i31)" (valtype_ok *c* '(:ref ((:null)) (:i31))) t)
(kase "V7 reftype_ok (ref null i31)" (reftype_ok *c* '(:ref ((:null)) (:i31))) t)
(kase "V8 deftype_ok A" (deftype_ok *c* *a*) t)
(kase "V9 storagetype_sub i32 <: i32" (storagetype_sub *c* '(:i32) '(:i32)) t)
(kase "V10 fieldtype_sub const i32" (fieldtype_sub *c* '(nil (:i32)) '(nil (:i32))) t)
