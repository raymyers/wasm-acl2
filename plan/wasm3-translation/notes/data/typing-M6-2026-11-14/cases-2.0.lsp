(include-book "wasm2")
(in-package "W2T")
(defconst *c* '(:%rec (:types) (:funcs) (:globals) (:tables) (:mems) (:elems) (:datas) (:locals) (:labels) (:return)))
(defconst *k1* '(:const (:i32) 1))
(defconst *add* '(:binop (:i32) (:add)))
(defun ty (a b) (list :|%->%| a b))
(defmacro kase (name form expect) `(cw "CASE ~s0: expected ~x1, got ~x2~%" ,name ,expect ,form))
(cw "ENC ~x0~%" (list (context-p *c*) (instr-p *k1*) (instr-p *add*) (functype-p (ty nil '((:i32))))))
(kase "2.0 A const" (instrs_ok *c* (list *k1*) (ty nil '((:i32)))) t)
(kase "2.0 B const const add" (instrs_ok *c* (list *k1* *k1* *add*) (ty nil '((:i32)))) t)
(kase "2.0 K const const const add add" (instrs_ok *c* (list *k1* *k1* *k1* *add* *add*) (ty nil '((:i32)))) t)
(kase "2.0 F block{const const add}" (instrs_ok *c* (list (list :block (list :_result '((:i32))) (list *k1* *k1* *add*))) (ty nil '((:i32)))) t)
(kase "2.0 J unreachable add" (instrs_ok *c* (list '(:unreachable) *add*) (ty nil '((:i32)))) t)
(kase "2.0 L const const (ill-typed)" (instrs_ok *c* (list *k1* *k1*) (ty nil '((:i32)))) nil)
(kase "2.0 split const const add from eps" (instrs_ok/split *c* (list *k1* *k1* *add*) nil) :some)
