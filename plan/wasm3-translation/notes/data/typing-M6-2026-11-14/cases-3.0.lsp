(ld "portcullis.acl2")
(set-ld-skip-proofsp t state)
(include-book "2_3-validation_instructions" :load-compiled-file nil)
(in-package "W3T")
(defconst *c* '(:%rec (:types) (:tags) (:globals) (:mems) (:tables) (:funcs) (:datas) (:elems) (:locals) (:labels) (:return) (:refs) (:recs)))
(defconst *i32* '(:i32))
(defconst *i31* '(:ref nil (:i31)))
(defconst *i31n* '(:ref ((:null)) (:i31)))
(defconst *anyn* '(:ref ((:null)) (:any)))
(defconst *k1* '(:const (:i32) 1))
(defconst *add* '(:binop (:i32) (:add)))
(defun ty (a x b) (list :|%->_%%| a x b))
(defmacro kase (name form expect) `(cw "CASE ~s0: expected ~x1, got ~x2~%" ,name ,expect ,form))
(cw "LT ~x0~%" (list (localtype-p '(:|%%| (:set) (:i32))) (localtype-p '((:set) (:i32)))))
(kase "sub I31<:EQ" (heaptype_sub *c* '(:i31) '(:eq)) t)
(kase "sub I31<:ANY (needs trans)" (heaptype_sub *c* '(:i31) '(:any)) t)
(kase "sub I31<:FUNC" (heaptype_sub *c* '(:i31) '(:func)) nil)
(kase "A const : eps->i32" (instrs_ok *c* (list *k1*) (ty nil nil (list *i32*))) t)
(kase "A' const : eps->i64" (instrs_ok *c* (list *k1*) (ty nil nil '((:i64)))) nil)
(kase "B const const add : eps->i32" (instrs_ok *c* (list *k1* *k1* *add*) (ty nil nil (list *i32*))) t)
(kase "B2 add : i32 i32->i32" (instrs_ok *c* (list *add*) (ty (list *i32* *i32*) nil (list *i32*))) t)
(kase "B3 add framed : i32 i32 i32->i32 i32" (instrs_ok *c* (list *add*) (ty (list *i32* *i32* *i32*) nil (list *i32* *i32*))) t)
(kase "B4 const framed : i32->i32 i32" (instrs_ok *c* (list *k1*) (ty (list *i32*) nil (list *i32* *i32*))) t)
(kase "B5 const add : i32->i32" (instrs_ok *c* (list *k1* *add*) (ty (list *i32*) nil (list *i32*))) t)
(kase "C const drop : eps->eps" (instrs_ok *c* (list *k1* '(:drop)) (ty nil nil nil)) t)
(kase "D nop nop : eps->eps" (instrs_ok *c* '((:nop) (:nop)) (ty nil nil nil)) t)
(kase "E block(i32){const} : eps->i32" (instrs_ok *c* (list (list :block (list :_result (list *i32*)) (list *k1*))) (ty nil nil (list *i32*))) t)
(kase "F block(i32){const const add}" (instrs_ok *c* (list (list :block (list :_result (list *i32*)) (list *k1* *k1* *add*))) (ty nil nil (list *i32*))) t)
(kase "G const ref.i31 : eps->(ref i31)" (instrs_ok *c* (list *k1* '(:ref.i31)) (ty nil nil (list *i31*))) t)
(kase "G2 const ref.i31 : eps->(ref null i31) (subsumption)" (instrs_ok *c* (list *k1* '(:ref.i31)) (ty nil nil (list *i31n*))) t)
(kase "G3 const ref.i31 : eps->anyref (subsumption+trans)" (instrs_ok *c* (list *k1* '(:ref.i31)) (ty nil nil (list *anyn*))) t)
(kase "H block(ref null i31){const ref.i31}" (instrs_ok *c* (list (list :block (list :_result (list *i31n*)) (list *k1* '(:ref.i31)))) (ty nil nil (list *i31n*))) t)
(kase "J unreachable add : eps->i32 (dead code)" (instrs_ok *c* (list '(:unreachable) *add*) (ty nil nil (list *i32*))) t)
(kase "K const const const add add" (instrs_ok *c* (list *k1* *k1* *k1* *add* *add*) (ty nil nil (list *i32*))) t)
(kase "L const const : eps->i32 (ill-typed)" (instrs_ok *c* (list *k1* *k1*) (ty nil nil (list *i32*))) nil)
(kase "M add : eps->i32 (ill-typed)" (instrs_ok *c* (list *add*) (ty nil nil (list *i32*))) nil)
(kase "S1 split const" (instrs_ok/split *c* (list *k1*) nil) :some)
(kase "S2 split const const add" (instrs_ok/split *c* (list *k1* *k1* *add*) nil) :some)
(kase "S3 split const add" (instrs_ok/split *c* (list *k1* *add*) (list *i32*)) :some)
(kase "X expr_ok/split const const add" (expr_ok/split *c* (list *k1* *k1* *add*)) :some)
(kase "X2 expr_ok const const add : i32" (expr_ok *c* (list *k1* *k1* *add*) (list *i32*)) t)
