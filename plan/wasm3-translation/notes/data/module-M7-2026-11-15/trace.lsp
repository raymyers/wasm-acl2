; Debug aid (wasm3 M7): for the module in (@ acl2::mfile) (a data-3.0 file),
; validate each function body with the sequencer and print the first
; instruction it rejects, with the stack. From translate/tests/spec:
;   { echo '(assign mfile "data-3.0/F.wasm")'; cat .../trace.lsp; } | acl2
(ld "t7-lib-3.0.acl2")
(in-package "W3T")
(include-book "t7-lib-3.0")
(program)
(defun mo-c (m)
  ;; the proposer's C (as module_ok computes it)
  (let* ((types (nth 1 m)) (imports (nth 2 m)) (tags (nth 3 m)) (globals (nth 4 m))
         (mems (nth 5 m)) (tables (nth 6 m)) (funcs (nth 7 m)) (datas (nth 8 m))
         (elems (nth 9 m)) (exports (nth 11 m))
         (dt1 (car (types_ok (mo-ctx nil nil nil nil nil nil nil nil nil) types)))
         (xti (mo-map :import (mo-ctx dt1 nil nil nil nil nil nil nil nil) imports))
         (dts (mo-func-types funcs dt1))
         (xs ($funcidx_nonfuncs (list globals mems tables elems exports)))
         (cp (mo-ctx dt1 nil ($globalsxt xti) nil nil (append ($funcsxt xti) dts) nil nil xs)))
    (mo-ctx dt1 (append ($tagsxt xti) (mo-map :tag cp tags)) (append ($globalsxt xti) (car (globals_ok cp globals)))
            (append ($memsxt xti) (mo-map :mem cp mems)) (append ($tablesxt xti) (mo-map :table cp tables))
            (append ($funcsxt xti) dts) (mo-oks datas) (mo-elem-types elems) xs)))
(defun local-types (c ls) (if (atom ls) nil (cons (car (local_ok c (car ls))) (local-types c (cdr ls)))))
(defun sets (ts) (if (atom ts) nil (cons (list '(:set) (car ts)) (sets (cdr ts)))))
(defun trace-run (c is stk poly)
  (if (atom is) (list :ok :stack stk :poly poly)
    (let* ((i (car is)) (p (seq-propose c i stk)))
      (if (null p)
          (if (member-eq (car i) (quote (:block :loop)))
              ;; descend: the body under {LABELS lab} ++ C, from t_1*
              (let* ((bt (cadr i))
                     (ft (and (eq (car bt) :_idx) (car (expand (nth (cadr (cadr bt)) (%get-field c :types))))))
                     (t1 (if ft (cadr ft) nil))
                     (t2 (if ft (caddr ft) (cadr bt)))
                     (ci (seq-put-field c :labels (cons (if (eq (car i) :loop) t1 t2) (%get-field c :labels)))))
                (list :in (car i) :results t2 (trace-run ci (caddr i) (reverse t1) nil)))
            (list :no-proposal (car i) :stack stk))
        (let* ((a (first p)) (x (second p)) (b (third p)) (n (acl2::len a))
               (have (min n (acl2::len stk))) (top (reverse (take have stk))))
          (cond ((not (instr_ok c i (list :%->_%% a x b))) (list :instr_ok-fails i :proposed a x b :stack stk))
                ((and (< (acl2::len stk) n) (not poly)) (list :too-few i :proposed a :stack stk))
                ((not (resulttype_sub c top (nthcdr (- n have) a))) (list :pop-fails i :proposed a :stack stk))
                (t (let ((p2 (seq-poly-p i)))
                     (trace-run (seq-with-locals c x) (cdr is)
                                (if p2 nil (append (reverse b) (nthcdr have stk)))
                                (or p2 poly))))))))))
(defun trace-funcs (c fs k)
  (if (atom fs) nil
    (let* ((f (car fs)) (dt (nth (cadr f) (%get-field c :types))) (ct (car (expand dt)))
           (t1 (cadr ct)) (t2 (caddr ct))
           (fc (%comp c (list :%rec '(:types) '(:tags) '(:globals) '(:mems) '(:tables) '(:funcs) '(:datas) '(:elems)
                              (cons :locals (append (sets t1) (local-types c (caddr f)))) (list :labels t2) (list :return t2) '(:refs) '(:recs))))
           (r (trace-run fc (cadddr f) nil nil)))
      (prog2$ (if (and (eq (car r) :ok) (expr_ok fc (cadddr f) t2)) nil (cw "FUNC ~x0: ~x1~%  expr_ok ~x2~%" k r (expr_ok fc (cadddr f) t2)))
              (trace-funcs c (cdr fs) (1+ k))))))
(mv-let (bs state) (read-bytes (@ acl2::mfile) state)
  (let ((m (car (gram/bmodule bs))))
    (prog2$ (cw "TRACE module_ok ~x0~%" (and (module_ok m) t))
            (prog2$ (trace-funcs (mo-c m) (nth 7 m) 0) (mv nil :ok state)))))
