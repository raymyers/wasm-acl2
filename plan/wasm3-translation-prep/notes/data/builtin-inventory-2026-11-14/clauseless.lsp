(ld "package.lsp")
(include-book "il2acl2/emit")
(in-package "IL2ACL2")
(set-state-ok t) (program)
(set-fmt-soft-right-margin 100000 state)
(set-fmt-hard-right-margin 100000 state)
(defun flat (forms) (cond ((endp forms) nil) ((is (car forms) "REC") (append (cdr (car forms)) (flat (cdr forms)))) (t (cons (car forms) (flat (cdr forms))))))
(defun has-clause (xs) (and (consp xs) (or (is (car xs) "CLAUSE") (has-clause (cdr xs)))))
(defun clauseless (fs) (cond ((endp fs) nil) ((and (is (car fs) "DEF") (not (has-clause (cddr (car fs))))) (cons (second (car fs)) (clauseless (cdr fs)))) (t (clauseless (cdr fs)))))
(defun hint-names-of (id hints) (cond ((endp hints) nil) ((and (equal (sym-name (second (car hints))) "DEF") (equal (third (car hints)) id)) (append (strip-cars (cdddr (car hints))) (hint-names-of id (cdr hints)))) (t (hint-names-of id (cdr hints)))))
(defun show (ids hints) (if (endp ids) nil (prog2$ (cw "~s0 ~x1~%" (car ids) (remove-duplicates-eq (hint-names-of (car ids) hints))) (show (cdr ids) hints))))
(defun run (f state) (mv-let (erp forms hints state) (read-il f state) (declare (ignore erp)) (let ((cl (clauseless (flat forms)))) (prog2$ (cw "~%FILE ~s0 clauseless ~x1~%" f (len cl)) (prog2$ (show cl hints) (mv nil nil state))))))
; From translate/. Prints FILE lines and one line per clause-less def with its hint names.
(run "il/wasm-1.0.il.sexp" state)
(run "il/wasm-2.0.il.sexp" state)
(run "il/wasm-3.0.il.sexp" state)
