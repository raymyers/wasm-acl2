(ld "package.lsp")
(include-book "il2acl2/emit")
(in-package "IL2ACL2")
(set-state-ok t) (program)
(defun drop-kinds (config kinds)
  (cond ((endp config) nil)
        ((member-eq (car (car config)) kinds) (drop-kinds (cdr config) kinds))
        (t (cons (car config) (drop-kinds (cdr config) kinds)))))
(defun form-id (x) (if (is x "REC") (list :rec (head (cadr x)) (second (cadr x)) (len (cdr x))) (list (head x) (second x))))
(defun loop-forms (xs skip nev cx)
  (if (endp xs) (mv nev cx)
    (if (member-equal (second (form-id (car xs))) skip)
        (prog2$ (cw "SKIPPING ~x0~%" (form-id (car xs))) (loop-forms (cdr xs) skip nev cx))
    (prog2$ (cw "FORM ~x0~%" (form-id (car xs)))
      (mv-let (e b s cx) (cform (car xs) cx)
        (declare (ignore b s))
        (loop-forms (cdr xs) skip (+ nev (len e)) cx))))))
(defun try-gen (il-file config-file skip state)
  (mv-let (erp forms state) (read-il-file il-file state)
    (declare (ignore erp))
    (mv-let (erp cfg state) (read-il-file config-file state)
      (declare (ignore erp))
      (let* ((config (drop-kinds (car cfg) '(:rel-override :il-patch)))
             (tbl (time$ (mangle-table forms)))
             (cx (list (cons :tbl tbl)
                       (cons :overrides (config-overrides config))
                       (cons :split-rules (split-rules (config-entries config :split)))
                       (cons :inverses (inverse-pairs (config-entries config :inverse)))
                       (cons :sized (sized-pairs (config-entries config :sized)))
                       (cons :decreasing (decreasing-pairs (config-entries config :decreasing)))
                       (cons :rel-overrides nil)
                       (cons :memo (memo-rels (config-entries config :memoize)))
                       (cons :gram-defs (gram-defs forms)))))
        (prog2$ (cw "MANGLED~%")
        (mv-let (nev cx) (loop-forms forms skip 0 cx)
          (prog2$ (cw "~%RESULT events ~x0~%nstubs ~x1~%STUBS ~x2~%nerrs ~x3~%INCOMPLETE ~x4~%"
                      nev (len (cx-get :stubs cx)) (reverse (cx-get :stubs cx))
                      (len (cx-get :errs cx)) (reverse (cx-get :incomplete cx)))
            (prog2$ (cw "ERRS ~x0~%" (reverse (cx-get :errs cx)))
            (mv nil nil state)))))))))
(time$ (try-gen "SCRATCH/wasm-3.0.il.sexp" "il2acl2-config.lsp" 'SKIPLIST state))
