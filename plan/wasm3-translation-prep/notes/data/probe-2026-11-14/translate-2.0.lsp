(ld "package.lsp")
(include-book "il2acl2/emit")
(in-package "IL2ACL2")
(set-state-ok t) (program)
(defun drop-kinds (config kinds)
  (cond ((endp config) nil)
        ((member-eq (car (car config)) kinds) (drop-kinds (cdr config) kinds))
        (t (cons (car config) (drop-kinds (cdr config) kinds)))))
(defun count-defuns (evs n)
  (cond ((endp evs) n)
        ((and (consp (car evs)) (eq (car (car evs)) 'mutual-recursion)) (count-defuns (cdr evs) (+ n (len (cdr (car evs))))))
        (t (count-defuns (cdr evs) (1+ n)))))
(defun err-kinds (errs acc)
  (if (endp errs) acc
    (let* ((e (car errs)) (k (if (consp e) (car e) e)) (old (cdr (assoc-equal k acc))))
      (err-kinds (cdr errs) (put-assoc-equal k (1+ (or old 0)) acc)))))
(defun try-gen (il-file config-file state)
  (mv-let (erp forms state) (read-il-file il-file state)
    (declare (ignore erp))
    (mv-let (erp cfg state) (read-il-file config-file state)
      (declare (ignore erp))
      (let* ((config (drop-kinds (car cfg) '(:rel-override :il-patch)))
             (cx (list (cons :tbl (mangle-table forms))
                       (cons :overrides (config-overrides config))
                       (cons :split-rules (split-rules (config-entries config :split)))
                       (cons :inverses (inverse-pairs (config-entries config :inverse)))
                       (cons :sized (sized-pairs (config-entries config :sized)))
                       (cons :decreasing (decreasing-pairs (config-entries config :decreasing)))
                       (cons :rel-overrides nil)
                       (cons :memo (memo-rels (config-entries config :memoize)))
                       (cons :gram-defs (gram-defs forms)))))
        (mv-let (events builtins skipped cx) (cforms forms cx)
          (prog2$ (cw "~%RESULT ~s0~%events ~x1 defuns ~x2 builtins ~x3 skipped ~x4~%nstubs ~x5~%STUBS ~x6~%nerrs ~x7~%ERRKINDS ~x8~%INCOMPLETE ~x9~%"
                      il-file (len events) (count-defuns events 0) (len builtins) (len skipped)
                      (len (cx-get :stubs cx)) (reverse (cx-get :stubs cx))
                      (len (cx-get :errs cx)) (err-kinds (cx-get :errs cx) nil) (reverse (cx-get :incomplete cx)))
            (prog2$ (cw "BUILTINS ~x0~%ERRS ~x1~%" builtins (reverse (cx-get :errs cx)))
            (mv nil nil state))))))))
(time$ (try-gen "SCRATCH/wasm-VER.il.sexp" "il2acl2-config.lsp" state))
