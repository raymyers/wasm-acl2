; P6: cost of one %SIZE over a configuration with a 1-page memory, versus one
; STEP of the call configuration and of one 12 steps into the loop. Run like bench.lsp.
(ld "cert.acl2")
(in-package "W1T")
(include-book "t7-lib")
(program)
(set-state-ok t)
(set-fmt-soft-right-margin 10000 state)
(set-fmt-hard-right-margin 10000 state)
(defun rep-size (x n) (if (zp n) nil (prog2$ (%size x) (rep-size x (1- n)))))
(defun rep-step (x n) (if (zp n) nil (prog2$ (step x) (rep-step x (1- n)))))
(defun mid-loop (c n) (if (zp n) c (let ((r (step c))) (if r (mid-loop (car r) (1- n)) c))))
(defun cost (file state)
  (mv-let (bs state) (read-bytes file state)
    (mv-let (st s inst) (instantiate (car (gram/bmodule bs)) (list *s0* nil nil nil))
      (declare (ignore st))
      (let* ((addr (find-export (str-bytes "count") (%get-field inst :exports)))
             (c ($invoke s (cadr addr) (list (list :const '(:i32) 5)))))
        (mv-let (t0 state) (read-run-time state)
          (prog2$ (rep-size c 20)
            (mv-let (t1 state) (read-run-time state)
              (prog2$ (rep-step c 20)
                (mv-let (t2 state) (read-run-time state)
                 (prog2$ (rep-step (mid-loop c 12) 20)
                 (mv-let (t3 state) (read-run-time state)
                  (prog2$ (cw "COST ~s0: one %SIZE ~x1 us, one STEP of the call ~x2 us, one STEP inside the loop ~x3 us~%" file
                               (floor (* 50 (- t1 t0) 1000000) 1000) (floor (* 50 (- t2 t1) 1000000) 1000) (floor (* 50 (- t3 t2) 1000000) 1000))
                          state))))))))))))
(cost "/Users/Apple/dev/wasm-acl2/plan/wasm3-translation-prep/notes/data/runtime-P6-2026-11-14/loop-0.wasm" state)
(cost "/Users/Apple/dev/wasm-acl2/plan/wasm3-translation-prep/notes/data/runtime-P6-2026-11-14/loop-1.wasm" state)
(cost "/Users/Apple/dev/wasm-acl2/plan/wasm3-translation-prep/notes/data/runtime-P6-2026-11-14/loop-4.wasm" state)
(acl2::good-bye 0)
