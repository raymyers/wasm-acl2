; P6 runtime baseline: steps and run time of the generated WASM 1.0 STEP on
; small modules (loop-<pages>.wasm, memloop-1.wasm). Run from translate/tests/spec/
; after certifying t7-lib:  acl2 < <this dir>/bench.lsp
(ld "cert.acl2")
(in-package "W1T")
(include-book "t7-lib")
(program)
(set-state-ok t)
(set-fmt-soft-right-margin 10000 state)
(set-fmt-hard-right-margin 10000 state)
(defun count-steps (c n k)
  ;; (mv steps final-config); final nil if n steps were not enough
  (if (zp n) (mv k nil)
    (let ((r (step c))) (if r (count-steps (car r) (1- n) (1+ k)) (mv k c)))))
(defun bench (file arg state)
  (mv-let (bs state) (read-bytes file state)
    (let ((m (car (gram/bmodule bs))))
      (mv-let (st s inst) (instantiate m (list *s0* nil nil nil))
        (if (not (eq st :ok)) (prog2$ (cw "BENCH ~s0 instantiate ~x1~%" file st) state)
          (let* ((addr (find-export (str-bytes "count") (%get-field inst :exports)))
                 (c ($invoke s (cadr addr) (list (list :const '(:i32) arg)))))
            (mv-let (t0 state) (read-run-time state)
              (mv-let (k fin) (count-steps c 1000000 0)
                (mv-let (t1 state) (read-run-time state)
                  (let ((secs (- t1 t0)))
                    (prog2$ (cw "BENCH ~s0 n=~x1 steps ~x2 seconds ~f3 ms/step ~f4 result ~x5~%"
                                 file arg k secs (if (zp k) 0 (/ (* 1000 secs) k))
                                 (and fin (caddr fin)))
                            state)))))))))))
(bench "/Users/Apple/dev/wasm-acl2/plan/wasm3-translation-prep/notes/data/runtime-P6-2026-11-14/loop-0.wasm" 20 state)
(bench "/Users/Apple/dev/wasm-acl2/plan/wasm3-translation-prep/notes/data/runtime-P6-2026-11-14/loop-0.wasm" 80 state)
