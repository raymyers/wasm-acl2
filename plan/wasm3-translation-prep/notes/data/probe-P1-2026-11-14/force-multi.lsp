; Compile the 3.0 type group with every member forced to :multi (P1-typing-root-causes).
; From translate/, after make probe SPEC=3.0. Prints the failing members and HEAPTYPE_SUB.
(ld "package.lsp")
(include-book "il2acl2/emit")
(in-package "IL2ACL2")
(set-state-ok t) (program)
(set-fmt-soft-right-margin 200 state)
(set-fmt-hard-right-margin 250 state)
(defun upto-group (forms id acc)
  (cond ((endp forms) (mv (reverse acc) nil))
        ((and (is (car forms) "REC") (equal (second (cadr (car forms))) id)) (mv (reverse acc) (car forms)))
        (t (upto-group (cdr forms) id (cons (car forms) acc)))))
(defun find-defun (ds name)
  (cond ((endp ds) nil)
        ((and (consp (car ds)) (eq (car (car ds)) 'defun) (equal (cdr (second (car ds))) name)) (car ds))
        ((and (consp (car ds)) (eq (car (car ds)) 'mutual-recursion)) (or (find-defun (cdr (car ds)) name) (find-defun (cdr ds) name)))
        (t (find-defun (cdr ds) name))))
(mv-let (erp forms state) (read-il-file ".probe/3.0/wasm-3.0.il.sexp" state)
  (declare (ignore erp))
  (mv-let (erp cfg state) (read-il-file "il2acl2-config.lsp" state)
   (declare (ignore erp))
   (let* ((config (car cfg))
          (cx (list (cons :tbl (mangle-table forms))
                    (cons :overrides (config-overrides config))
                    (cons :split-rules (split-rules (config-entries config :split)))
                    (cons :inverses (inverse-pairs (config-entries config :inverse)))
                    (cons :sized (sized-pairs (config-entries config :sized)))
                    (cons :decreasing (decreasing-pairs (config-entries config :decreasing)))
                    (cons :memo (memo-rels (config-entries config :memoize)))
                    (cons :gram-defs (gram-defs forms)))))
    (mv-let (pre grp) (upto-group forms "Heaptype_ok" nil)
      (mv-let (e b s cx) (cforms pre cx)
        (declare (ignore e b s))
        (let* ((xs (cdr grp))
               (cx (cx-put :rec-rels (strip-seconds xs) cx))
               (cx (set-mode-ids (strip-seconds xs) :multi (cx-put :errs nil cx))))
          (mv-let (ds bad cx) (crel-members xs cx)
            (prog2$ (cw "BAD ~x0~%NERRS ~x1~%" bad (len (cx-get :errs cx)))
              (prog2$ (cw "~%TRANS-AUX:~%")
                (prog2$ (cw "~x0~%" (find-defun ds "HEAPTYPE_SUB"))
                  (mv nil nil state)))))))))))
