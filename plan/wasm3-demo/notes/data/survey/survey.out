553:(defun equalp (x y)
554-  (cond
555-    ((eql x y) t)
556-    ((characterp x)
557-     (and (characterp y)
558-          (char-equal x y)))
559-    ((hash-table-p x)
560-     (and (hash-table-p y)
561-          (eql (hash-table-test x) (hash-table-test y))
