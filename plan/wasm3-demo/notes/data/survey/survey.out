== jscl equal
352:(defun equal (x y)
353-  (cond
354-    ((eql x y) t)
355-    ((consp x)
356-     (and (consp y)
357-          (equal (car x) (car y))
358-          (equal (cdr x) (cdr y))))
359-    ((stringp x)
360-     (and (stringp y) (string= x y)))
