(ld "build/render-defs.lsp")
(in-package "WE")
:q
(require :sb-sprof)
(format t "~&LIVE ~s~%" (acl2::the-live-var 'we::fm))
(sb-ext:gc :full t)
(let ((b0 (sb-ext:get-bytes-consed)) (t0 (get-internal-run-time))
      (live (cdr (assoc 'we::fm acl2::*user-stobj-alist*))))
  (sb-sprof:with-profiling (:max-samples 400000 :sample-interval 0.0005 :mode :cpu :report nil)
    (we::render-deck "build/sent.wasm" "/private/tmp/claude-501/-Users-Apple-dev-wasm-acl2/41dcd935-9a00-4395-896c-5bb647eb9223/scratchpad/prof" live acl2::*the-live-state*))
  (format t "~&ALLOC bytes ~a run-ms ~a~%" (- (sb-ext:get-bytes-consed) b0)
          (round (* 1000 (- (get-internal-run-time) t0)) internal-time-units-per-second)))
(sb-sprof:report :type :flat :max 45 :stream *standard-output*)
(acl2::exit-lisp 0)
