; E2: cost of the spec's memory.fill and memory.copy (they expand to one
; store, or one load and one store, per byte). Harness of wasm3 M3's bench.lsp.
; From translate/gen/wasm-3.0:  acl2 < <this file>
(ld "portcullis.acl2")
(include-book "wasm3")
(in-package "W3T")
(program)
(set-state-ok t)
(defun i32c (n) (list :const '(:i32) n))
(defconst *mi* '(:%rec (:types) (:tags) (:globals) (:mems 0) (:tables) (:funcs) (:datas) (:elems) (:exports)))
(defun meminst (pages)
  (list :%rec (cons :type (list :page '(:i32) (list :[%..%] pages nil)))
        (cons :bytes (make-list (* pages 65536) :initial-element 0))))
(defun store (pages)
  (list :%rec '(:tags) '(:globals) (cons :mems (list (meminst pages)))
        '(:tables) '(:funcs) '(:datas) '(:elems) '(:structs) '(:arrays) '(:exns)))
(defun cfg (pages instrs)
  (list :|%;%| (list :|%;%| (store pages) (list :%rec (cons :locals nil) (cons :module *mi*))) instrs))
(defun run (c k)
  (let ((r (step c)))
    (if (or (zp k) (atom r)) (mv k (caddr c)) (run (car r) (1- k)))))
(defun bench-of (name instrs state)
  (let ((c (cfg 1 instrs)))
    (mv-let (t0 state) (read-run-time state)
      (mv-let (left final) (run c 1000000)
        (mv-let (t1 state) (read-run-time state)
          (let ((steps (- 1000000 left)))
            (prog2$ (cw "BULK ~s0: ~x1 steps, final ~x2, ~x3 s, ~x4 ms/step~%"
                        name steps final (/ (round (* 1000 (- t1 t0)) 1) 1000)
                        (if (zp steps) 0 (/ (round (* 1000000 (/ (- t1 t0) steps)) 1) 1000)))
                    (mv nil :ok state))))))))
(bench-of "fill 100" (list (i32c 10) (i32c 85) (i32c 100) '(:memory.fill 0)) state)
(bench-of "fill 400" (list (i32c 10) (i32c 85) (i32c 400) '(:memory.fill 0)) state)
(bench-of "copy 100" (list (i32c 1000) (i32c 10) (i32c 100) '(:memory.copy 0 0)) state)
(bench-of "copy 400" (list (i32c 1000) (i32c 10) (i32c 400) '(:memory.copy 0 0)) state)
