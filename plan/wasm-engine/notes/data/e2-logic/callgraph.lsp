; E2: the :program functions reachable from STEP in the certified 3.0 books.
; Run from translate/tests/sem-3.0/:  acl2 < <this file>
; Output at 78d1584: callgraph-78d1584.txt
; Prints, for every :program function reachable from the roots, its direct
; :program callees. A function with none ("LEAF") failed on its own.
(set-ld-error-action (quote (:exit 1)) state)
(ld "cert.acl2")
(in-package "ACL2")
(include-book "../../gen/wasm-3.0/wasm3")
(program)
(set-state-ok t)
(defun e2-syms (x acc)
  (cond ((consp x) (e2-syms (car x) (e2-syms (cdr x) acc)))
        ((and (symbolp x) x) (add-to-set-eq x acc))
        (t acc)))
(defun e2-prog-p (f wrld)
  (and (function-symbolp f wrld)
       (eq (symbol-class f wrld) :program)))
(defun e2-filter (syms self wrld)
  (cond ((endp syms) nil)
        ((and (not (eq (car syms) self)) (e2-prog-p (car syms) wrld)
              (not (equal (symbol-package-name (car syms)) "COMMON-LISP"))
              (not (equal (symbol-package-name (car syms)) "ACL2")))
         (cons (car syms) (e2-filter (cdr syms) self wrld)))
        (t (e2-filter (cdr syms) self wrld))))
(defun e2-callees (f wrld)
  (e2-filter (e2-syms (cddr (cltl-def-from-name f wrld)) nil) f wrld))
(defun e2-walk (todo seen n wrld)
  (cond ((or (zp n) (endp todo)) (reverse seen))
        ((assoc-eq (car todo) seen) (e2-walk (cdr todo) seen (1- n) wrld))
        (t (let ((cs (e2-callees (car todo) wrld)))
             (e2-walk (append cs (cdr todo)) (cons (cons (car todo) cs) seen) (1- n) wrld)))))
(set-current-package "W3T" state)
(acl2::cw "E2-GRAPH ~x0~%" (acl2::e2-walk '(steps) nil 100000 (acl2::w state)))
(acl2::good-bye 0)
