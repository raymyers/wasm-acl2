; E1 item 5: the MuPDF module through the generated 3.0 decoder (GRAM/BMODULE)
; and validator (MODULE_OK), each timed. From engine/mupdf inside
; `nix develop ../..`, with the module from build.sh:
;   (echo '(assign wasm-file "PATH/mupdf-wasm.wasm")'; cat decode.lsp) \
;     | SBCL_USER_ARGS='--control-stack-size 4000' acl2 > decode.out
(ld "../../translate/gen/wasm-3.0/portcullis.acl2")
(include-book "../../translate/gen/wasm-3.0/wasm3")
(in-package "W3T")
(program)
(set-state-ok t)
(defun read-bytes-loop (channel acc state)
  (mv-let (b state) (read-byte$ channel state)
    (if (null b) (mv (reverse acc) state) (read-bytes-loop channel (cons b acc) state))))
(defun read-bytes (file state)
  (mv-let (channel state) (open-input-channel file :byte state)
    (if (null channel) (mv nil state)
      (mv-let (bs state) (read-bytes-loop channel nil state)
        (let ((state (close-input-channel channel state))) (mv bs state))))))
(defun field-lens (l) (if (atom l) nil (cons (if (true-listp (car l)) (acl2::len (car l)) :atom) (field-lens (cdr l)))))
(defun ms (t0 t1) (round (* 1000 (- t1 t0)) 1))
(defun decode-mupdf (file state)
  (mv-let (t0 state) (read-run-time state)
    (mv-let (bs state) (read-bytes file state)
      (mv-let (t1 state) (read-run-time state)
        (prog2$ (cw "E1-DECODE read ~x0 bytes in ~x1 ms~%" (acl2::len bs) (ms t0 t1))
          (let ((p (gram/bmodule bs)))
            (mv-let (t2 state) (read-run-time state)
              (prog2$ (cw "E1-DECODE parse: ~s0, rest ~x1 bytes, ~x2 ms~%"
                          (if (and p (null (cadr p))) "complete" (if p "partial" "failed"))
                          (acl2::len (cadr p)) (ms t1 t2))
                (let ((m (and p (null (cadr p)) (car p))))
                  (prog2$ (and m (cw "E1-DECODE module ~x0, field lengths in order ~x1~%" (car m) (field-lens (cdr m))))
                    (let ((ok (and m (module_ok m))))
                      (mv-let (t3 state) (read-run-time state)
                        (prog2$ (cw "E1-DECODE Module_ok: ~x0, ~x1 ms~%" (and ok t) (ms t2 t3))
                                (mv nil :ok state))))))))))))))
(decode-mupdf (@ acl2::wasm-file) state)
