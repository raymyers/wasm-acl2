(ld "cert.acl2")
(include-book "fast")
(in-package "WE")
:q
(defmacro bench (name setup form)
  `(let ((t0 (get-internal-real-time)))
     (dotimes (i 1000000) ,setup ,form)
     (format t "~&MICRO ~a: ~,3f us per call~%" ,name
             (/ (- (get-internal-real-time) t0) (/ internal-time-units-per-second 1000000.0) 1000000))))
(defvar *fm* (cdr (assoc (quote we::fm) acl2::*user-stobj-alist*)))
(defun set-fm (frame vals is)
  (we::update-fm-store nil *fm*) (we::update-fm-frame frame *fm*) (we::update-fm-vals vals *fm*)
  (we::update-fm-is is *fm*) (we::update-fm-ctrl nil *fm*) (we::update-fm-status :run *fm*))
(bench "setup only" (set-fm nil nil nil) nil)
(bench "fast-step binop" (set-fm nil '((:const (:i32) 2) (:const (:i32) 7)) '((:binop (:i32) (:sub)))) (we::fast-step *fm*))
(bench "fast-step value push" (set-fm nil nil '((:const (:i32) 2) (:binop (:i32) (:sub)))) (we::fast-step *fm*))
(bench "fast-step local.get" (set-fm '(:%rec (:locals (:const (:i32) 5)) (:module)) nil '((:local.get 0))) (we::fast-step *fm*))
(bench "fast-step local.set" (set-fm '(:%rec (:locals (:const (:i32) 5)) (:module)) '((:const (:i32) 9)) '((:local.set 0))) (we::fast-step *fm*))
(bench "fast-step relop" (set-fm nil '((:const (:i32) 2) (:const (:i32) 7)) '((:relop (:i32) (:lt :u)))) (we::fast-step *fm*))
(bench "fast-step br_if" (set-fm nil '((:const (:i32) 0)) '((:br_if 0))) (we::fast-step *fm*))
(format t "~&STATUS ~s IS ~s VALS ~s~%" (we::fm-status *fm*) (we::fm-is *fm*) (we::fm-vals *fm*))
(acl2::exit-lisp 0)
