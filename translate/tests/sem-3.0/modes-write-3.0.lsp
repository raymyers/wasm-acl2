; Rewrite tests/sem-3.0/modes-3.0.lsp from the certified 3.0 books (`make modes SPEC=3.0`, wasm3 M9).
; Run from tests/sem-3.0/ after certifying gen/wasm-3.0/wasm3 and ../sem/modes-lib.
(set-ld-error-action (quote (:exit 1)) state)
(ld "cert.acl2")
(in-package "ACL2")
(include-book "../../gen/wasm-3.0/wasm3")
(include-book "../sem/modes-lib")
(set-state-ok t)
(program)
(defun %modes-print-entries (es channel state)
  (if (endp es) state
    (mv-let (col state) (fmt1! "  ~x0~%" (list (cons #\0 (car es))) 0 channel state nil)
      (declare (ignore col))
      (%modes-print-entries (cdr es) channel state))))
(defun %modes-print-parts (ps channel state)
  (if (endp ps) state
    (mv-let (col state) (fmt1! " (~x0~%" (list (cons #\0 (car (car ps)))) 0 channel state nil)
      (declare (ignore col))
      (let* ((state (%modes-print-entries (cdr (car ps)) channel state))
             (state (princ$ " )" channel state))
             (state (newline channel state)))
        (%modes-print-parts (cdr ps) channel state)))))
(defun %modes-write (state)
  (mv-let (parts state) (%modes-manifest "../../gen/wasm-3.0/" "wasm3" state)
    (mv-let (channel state) (open-output-channel "modes-3.0.lsp" :character state)
      (let* ((state (princ$ "; GENERATED by `make modes` (tests/sem-3.0/modes-write-3.0.lsp) from the certified" channel state))
             (state (newline channel state))
             (state (princ$ "; books: the defun-mode of every generated function, per part in IL order." channel state))
             (state (newline channel state))
             (state (princ$ "; tests/sem-3.0/t0-modes-3.0.lisp fails when certification gives different modes." channel state))
             (state (newline channel state))
             (state (fms! "; :guards ~x0, :logic ~x1, :program ~x2~%("
                          (list (cons #\0 (%modes-count parts :guards))
                                (cons #\1 (%modes-count parts :logic))
                                (cons #\2 (%modes-count parts :program)))
                          channel state nil))
             (state (newline channel state))
             (state (%modes-print-parts parts channel state))
             (state (princ$ ")" channel state))
             (state (newline channel state))
             (state (close-output-channel channel state)))
        (prog2$ (cw "modes-3.0.lsp: :guards ~x0, :logic ~x1, :program ~x2~%"
                    (%modes-count parts :guards) (%modes-count parts :logic) (%modes-count parts :program))
                state)))))
(set-current-package "W3T" state) ; read and print generated names unqualified
(acl2::%modes-write state)
(acl2::good-bye 0)
