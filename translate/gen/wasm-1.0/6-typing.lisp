  (DECLARE (IGNORABLE %A0 %A1))
  (LET ((%R (LET* ((C^U %A0))
              (DECLARE (IGNORABLE C^U))
              (AND (CONSP %A1)
                   (EQ (CAR %A1) :FUNC)
                   (TRUE-LISTP (CDR %A1))
                   (EQUAL (ACL2::LEN (CDR %A1)) 1)
                   (LET* ((X (CAR (CDR %A1))))
                     (DECLARE (IGNORABLE X))
                     (AND (< X (ACL2::LEN (%GET-FIELD C^U :FUNCS)))
                          (LET* ((FT (NTH X (%GET-FIELD C^U :FUNCS))))
                            (DECLARE (IGNORABLE FT))
                            (LIST (%RULE "Externidx_ok/func"
                                         (LIST :FUNC FT))))))))))
   (DECLARE (IGNORABLE %R))
   (IF %R %R
    (LET ((%R (LET* ((C^U %A0))
                (DECLARE (IGNORABLE C^U))
                (AND (CONSP %A1)
                     (EQ (CAR %A1) :GLOBAL)
                     (TRUE-LISTP (CDR %A1))
                     (EQUAL (ACL2::LEN (CDR %A1)) 1)
                     (LET* ((X (CAR (CDR %A1))))
                       (DECLARE (IGNORABLE X))
                       (AND (< X (ACL2::LEN (%GET-FIELD C^U :GLOBALS)))
                            (LET* ((GT (NTH X (%GET-FIELD C^U :GLOBALS))))
                              (DECLARE (IGNORABLE GT))
                              (LIST (%RULE "Externidx_ok/global"
                                           (LIST :GLOBAL GT))))))))))
     (DECLARE (IGNORABLE %R))
     (IF %R %R
      (LET ((%R (LET* ((C^U %A0))
                  (DECLARE (IGNORABLE C^U))
                  (AND (CONSP %A1)
                       (EQ (CAR %A1) :TABLE)
                       (TRUE-LISTP (CDR %A1))
                       (EQUAL (ACL2::LEN (CDR %A1)) 1)
                       (LET* ((X (CAR (CDR %A1))))
                         (DECLARE (IGNORABLE X))
                         (AND (< X (ACL2::LEN (%GET-FIELD C^U :TABLES)))
                              (LET* ((TT (NTH X (%GET-FIELD C^U :TABLES))))
                                (DECLARE (IGNORABLE TT))
                                (LIST (%RULE "Externidx_ok/table"
                                             (LIST :TABLE TT))))))))))
        (DECLARE (IGNORABLE %R))
        (IF %R %R
          (LET ((%R (LET* ((C^U %A0))
                      (DECLARE (IGNORABLE C^U))
                      (AND (CONSP %A1)
                           (EQ (CAR %A1) :MEM)
                           (TRUE-LISTP (CDR %A1))
                           (EQUAL (ACL2::LEN (CDR %A1)) 1)
                           (LET* ((X (CAR (CDR %A1))))
                             (DECLARE (IGNORABLE X))
                             (AND (< X (ACL2::LEN (%GET-FIELD C^U :MEMS)))
                                  (LET* ((MT (NTH X (%GET-FIELD C^U :MEMS))))
                                    (DECLARE (IGNORABLE MT))
                                    (LIST (%RULE "Externidx_ok/mem"
                                                 (LIST :MEM MT))))))))))
            (DECLARE (IGNORABLE %R))
            (IF %R %R NIL))))))))))


(%TRY-GUARDS EXTERNIDX_OK)

(%TRY-LOGIC
   (DEFUN EXPORT_OK (%A0 %A1 %A2)
     (DECLARE (IGNORABLE %A0 %A1 %A2))
     (LET ((%R (LET* ((C^U %A0))
                 (DECLARE (IGNORABLE C^U))
                 (AND (CONSP %A1)
                      (EQ (CAR %A1) :EXPORT)
                      (TRUE-LISTP (CDR %A1))
                      (EQUAL (ACL2::LEN (CDR %A1)) 2)
                      (LET* ((NAME (CAR (CDR %A1)))
                             (EXTERNIDX (CAR (CDR (CDR %A1)))))
                        (DECLARE (IGNORABLE NAME EXTERNIDX))
                        (AND (EQUAL %A2 NAME)
                             (LET* ((%T0 (EXTERNIDX_OK C^U EXTERNIDX)))
                               (DECLARE (IGNORABLE %T0))
                               (AND %T0
                                    (LET* ((XT (CAR %T0)))
                                      (DECLARE (IGNORABLE XT))
                                      (LIST (%RULE "Export_ok/" XT)))))))))))
       (DECLARE (IGNORABLE %R))
       (IF %R %R NIL))))


(%TRY-GUARDS EXPORT_OK)

(%TRY-LOGIC (DEFUN MODULE_OK/%TYPES (TS)
              (IF (ATOM TS)
                  (LIST NIL)
                (LET ((R (TYPE_OK (CAR TS)))
                      (REST (MODULE_OK/%TYPES (CDR TS))))
                  (AND R REST
                       (LIST (CONS (CAR R) (CAR REST))))))))


(%TRY-GUARDS MODULE_OK/%TYPES)

(%TRY-LOGIC (DEFUN MODULE_OK/%IMPORTS (C IMS)
              (IF (ATOM IMS)
                  (LIST NIL)
                (LET ((R (IMPORT_OK C (CAR IMS)))
                      (REST (MODULE_OK/%IMPORTS C (CDR IMS))))
                  (AND R REST
                       (LIST (CONS (CAR R) (CAR REST))))))))


(%TRY-GUARDS MODULE_OK/%IMPORTS)

(%TRY-LOGIC (DEFUN MODULE_OK/%GLOBALS (C GS)
