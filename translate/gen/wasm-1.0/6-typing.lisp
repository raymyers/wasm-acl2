                  (LIST NIL)
                (LET ((R (GLOBAL_OK/SPLIT C (CAR GS)))
                      (REST (MODULE_OK/%GLOBALS C (CDR GS))))
                  (AND R REST
                       (LIST (CONS (CAR R) (CAR REST))))))))


(%TRY-GUARDS MODULE_OK/%GLOBALS)

